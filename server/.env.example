DATABASE_URL=postgres://user:password@host/dbname
PORT=3001
# GitHub Pages URL — always https://<username>.github.io/<repo>
# You can set this before deploying — the URL is predictable
FRONTEND_URL=https://<your-github-username>.github.io/hotelops
# JWT signing secret — REQUIRED in production (>= 32 random chars).
# Tokens issued for staff and admin sessions are signed with this; anyone
# who knows it can mint an admin token. If unset the server falls back to
# a random per-boot secret (sessions reset on every restart).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Sprint 17 (Front Desk forecast) ────────────────────────
# Agilysys rGuest Stay credentials. The forecast scraper logs in
# with these and replays the SPA's x-token header to call the
# property-service / reservation-service endpoints directly.
# Set as secrets in Koyeb; do NOT commit real values here.
# Tenant + property IDs are Snoqualmie's and are hardcoded in
# server/agilysys/client.js — only credentials live in env.
AGILYSYS_USER=
AGILYSYS_PASS=
