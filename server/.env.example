DATABASE_URL=postgres://user:password@host/dbname
PORT=3001
# GitHub Pages URL — always https://<username>.github.io/<repo>
# You can set this before deploying — the URL is predictable
FRONTEND_URL=https://<your-github-username>.github.io/hotelops
# JWT signing secret — must be a long random string in production.
# Tokens issued for staff and admin sessions are signed with this.
JWT_SECRET=change-me-to-a-long-random-string
